{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanbox",
  "version": "0.8.3",
  "identifier": "com.kanbox.app",
  "build": {
    "beforeDevCommand": "npm run desktop:preview",
    "beforeBuildCommand": "npm run build:native && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http://127.0.0.1:4318; media-src 'self' http://127.0.0.1:4318; connect-src 'self' http://127.0.0.1:4318"
    },
    "windows": [
      {
        "title": "Kanbox",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 760,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "resources": {
      "../scripts/local-api.mjs": "local-api.mjs",
      "../scripts/kanbox-mcp.mjs": "kanbox-mcp.mjs",
      "../scripts/macos-vision-ocr.js": "macos-vision-ocr.js",
      "../scripts/lib/anonymous-note-resolver.mjs": "lib/anonymous-note-resolver.mjs",
      "../scripts/lib/ai-service.mjs": "lib/ai-service.mjs",
      "../scripts/lib/cache-cover-recovery.mjs": "lib/cache-cover-recovery.mjs",
      "../scripts/lib/category-inference.mjs": "lib/category-inference.mjs",
      "../scripts/lib/media-import.mjs": "lib/media-import.mjs",
      "../scripts/lib/note-import.mjs": "lib/note-import.mjs",
      "../scripts/lib/note-search.mjs": "lib/note-search.mjs",
      "../scripts/lib/video-import.mjs": "lib/video-import.mjs",
      "../scripts/lib/text-summary.mjs": "lib/text-summary.mjs",
      "../scripts/lib/pinyin-search.mjs": "lib/pinyin-search.mjs",
      "../scripts/lib/storage-location.mjs": "lib/storage-location.mjs",
      "../scripts/lib/ai-provider-presets.mjs": "lib/ai-provider-presets.mjs",
      "../scripts/lib/full-archive.mjs": "lib/full-archive.mjs",
      "../scripts/lib/sync-merge.mjs": "lib/sync-merge.mjs",
      "bin/kanbox-video-analyzer": "kanbox-video-analyzer",
      "bin/kanbox-node": "kanbox-node",
      "bin/kanbox-node-LICENSE": "kanbox-node-LICENSE",
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/background.js": "browser-extension/background.js",
      "../browser-extension/content.js": "browser-extension/content.js",
      "../browser-extension/page-data.js": "browser-extension/page-data.js",
      "../browser-extension/popup.html": "browser-extension/popup.html",
      "../browser-extension/popup.js": "browser-extension/popup.js",
      "../browser-extension/icons/icon-16.png": "browser-extension/icons/icon-16.png",
      "../browser-extension/icons/icon-32.png": "browser-extension/icons/icon-32.png",
      "../browser-extension/icons/icon-48.png": "browser-extension/icons/icon-48.png",
      "../browser-extension/icons/icon-128.png": "browser-extension/icons/icon-128.png",
      "../browser-extension/icons/icon.svg": "browser-extension/icons/icon.svg"
    },
    "icon": [
      "icons/icon-v4.icns"
    ]
  }
}
